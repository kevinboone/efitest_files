# Makefile for efitest, Linux test harness
# Copyright (c)2026 Kevin Boone, GPLv3.0

CFLAGS         = -I $(EFI_INCS) -fno-stack-protector -fpic \
		  -fshort-wchar -Wall -DLINUX

LDFLAGS        = 

# Work out the objects and sources from the src/ directory, rather than specifying
#  them explicitly in the Makefile
SOURCES        := $(sort $(shell find src/ -type f -name *.c))
OBJECTS        := $(patsubst src/%,build/%,$(SOURCES:.c=.o))

all: test

build/%.o: src/%.c
	@mkdir -p build/
	gcc $(CFLAGS) -MD -MF $(@:.o=.deps) -c -o $@ $< 

test: $(OBJECTS) 
	gcc $(LDFLAGS) -o test $(OBJECTS) 

clean:
	rm -rf test.iso build/ img/ test


